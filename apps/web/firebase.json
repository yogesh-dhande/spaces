{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/opengraph-image",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ]
      },
      {
        "source": "**/*.@(mp4|m4v|mov|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=14400, no-transform"
          }
        ]
      }
    ]
  }
}
