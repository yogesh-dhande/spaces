{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(mp4|m4v|mov|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=14400, no-transform"
          }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/releases/(?P<archive>Spaces)-(?P<version>[0-9]+(?:\\.[0-9]+)*)\\.zip$",
        "destination": "https://github.com/yogesh-dhande/spaces/releases/download/v:version/:archive-:version.zip",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
