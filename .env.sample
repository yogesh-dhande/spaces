# Copy this file to .env and set local-only values.

# Remote E2E compute-host settings.
# E2E scripts load .env by default. Set SPACES_ENV_FILE to use a different file,
# or SPACES_SKIP_ENV_FILE=1 to ignore .env for one run.
SPACES_E2E_REMOTE_SSH_HOST=
SPACES_E2E_REMOTE_SSH_USER=
# SPACES_E2E_REMOTE_SSH_PORT=
SPACES_E2E_REMOTE_DAEMON_HOST=
SPACES_E2E_REMOTE_DAEMON_PORT=47847
SPACES_E2E_REMOTE_WORKSPACE_ROOT="~/.spaces/e2e-workspaces"
SPACES_E2E_REMOTE_GIT_ROOT="~/.spaces/e2e-git"
SPACES_E2E_REMOTE_HOST_ID=keptune-remote-e2e
SPACES_E2E_REMOTE_NAME="Keptune Remote E2E"
# SPACES_E2E_REMOTE_AUTH_TOKEN=

# iOS physical-device install settings.
# Set the UDID for the connected iPhone or iPad.
# Find device UDIDs with:
#   xcrun xctrace list devices
SPACES_IOS_DEVICE_UDID=

# Optional: override the Xcode development team used for device signing.
# SPACES_IOS_DEVELOPMENT_TEAM=

# Optional: set to 0 to install without launching.
# SPACES_IOS_LAUNCH=1

# macOS package signing and notarization settings.
# Leave CODESIGN_IDENTITY empty for ad-hoc signing in local package scripts.
CODESIGN_IDENTITY=

# Set to 1 to notarize release artifacts.
NOTARIZE=0

# Required when NOTARIZE=1.
APPLE_ID=
TEAM_ID=
APP_PASSWORD=
