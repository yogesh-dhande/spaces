# Copy this file to .env and set local-only values.

# iOS physical-device install settings.
# Set the UDID for the connected iPhone or iPad.
# Find device UDIDs with:
#   xcrun xctrace list devices
SPACES_IOS_DEVICE_UDID=

# Optional: override the Xcode development team used for device signing.
# SPACES_IOS_DEVELOPMENT_TEAM=

# Optional: set to 0 to install without launching.
# SPACES_IOS_LAUNCH=1

# macOS package signing and notarization settings.
# Leave CODESIGN_IDENTITY empty for ad-hoc signing in local package scripts.
CODESIGN_IDENTITY=

# Set to 1 to notarize release artifacts.
NOTARIZE=0

# Required when NOTARIZE=1.
APPLE_ID=
TEAM_ID=
APP_PASSWORD=
